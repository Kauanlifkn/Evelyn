{
  "name": "hidro-alerta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:seed": "tsx scripts/db-seed.mts",
    "db:status": "tsx scripts/db-status.mts",
    "db:test": "tsx scripts/db-setup.mts hidro_alerta_test",
    "db:reset-test": "node --env-file=.env -e \"const{Pool}=require('pg');(async()=>{const b=new URL(process.env.DATABASE_URL);b.pathname='/postgres';const a=new Pool({connectionString:b.toString()});await a.query('DROP DATABASE IF EXISTS hidro_alerta_test');await a.query('CREATE DATABASE hidro_alerta_test');await a.end();console.log('test db recriado');})();\"",
    "test:db": "RUN_DB_TESTS=1 npx vitest run src/tests/integration"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.29.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.1"
  }
}
